# Copy to ~/.local/share/<agent-id>/.env and adjust.
# Used by services/agent-template/start-cli-agent.sh (Codex / Grok workers).
# For OpenCode-backed workers, use env.example + start-opencode-agent.sh.

# --- identity (required) ----------------------------------------------------
REALM_AGENT_ID=<agent-id>
REALM_AGENT_NAME=<agent-id>
REALM_USERNAME=<agent-id>
REALM_NATS_URL=nats://agentnet_secret_token@localhost:4222

# --- runtime: codex | grok --------------------------------------------------
# OpenCode is NOT supported by start-cli-agent.sh — use start-opencode-agent.sh.
REALM_RUNTIME=codex

# Working directory the brain CLI will use as project root.
REALM_WORKDIR=/Users/a.developer/.local/share/<agent-id>

# Optional long-lived role / personality (file wins if both set).
# REALM_SYSTEM_PROMPT_FILE=/Users/a.developer/.local/share/<agent-id>/system-prompt.md
# REALM_SYSTEM_PROMPT=You are a coding worker on the Realm mesh.

# Handler + brain budgets (seconds). Keep large for agentic jobs.
REALM_WORK_TIMEOUT_SECONDS=86400
REALM_BRAIN_TIMEOUT=86400

# ---------------------------------------------------------------------------
# Sample: @codex-worker
# ---------------------------------------------------------------------------
# REALM_AGENT_ID=codex-worker
# REALM_AGENT_NAME=codex-worker
# REALM_USERNAME=codex-worker
# REALM_RUNTIME=codex
# REALM_WORKDIR=/Users/a.developer/Documents/Realm
# CODEX_BIN=/opt/homebrew/bin/codex
# CODEX_MODEL=gpt-5.6-terra
# # sandbox: read-only | workspace-write | danger-full-access
# CODEX_SANDBOX=workspace-write
# # If true, pass --dangerously-bypass-approvals-and-sandbox (dangerous).
# CODEX_FULL_AUTO=false
# CODEX_JSON=false
# CODEX_SKIP_GIT_CHECK=true

# ---------------------------------------------------------------------------
# Sample: @grok-worker
# ---------------------------------------------------------------------------
# REALM_AGENT_ID=grok-worker
# REALM_AGENT_NAME=grok-worker
# REALM_USERNAME=grok-worker
# REALM_RUNTIME=grok
# REALM_WORKDIR=/Users/a.developer/Documents/Realm
# GROK_BIN=/Users/a.developer/.local/bin/grok
# GROK_MODEL=grok-4.5
# # Headless auto-approve tool runs (default true).
# GROK_ALWAYS_APPROVE=true
# # plain | json | streaming-json
# GROK_OUTPUT_FORMAT=plain
# # agent = multi-turn positional prompt; single = grok -p/--single
# GROK_MODE=agent

# Optional API keys (prefer machine-level secrets; do not commit).
# OPENAI_API_KEY=
# XAI_API_KEY=
# GITHUB_PERSONAL_ACCESS_TOKEN=
