# Copy to ~/.local/share/<agent-id>/.env and adjust.

REALM_AGENT_ID=<agent-id>
REALM_AGENT_NAME=<agent-id>
REALM_USERNAME=<agent-id>
REALM_NATS_URL=nats://agentnet_secret_token@localhost:4222

OPENCODE_PORT=<unique-local-port>
OPENCODE_HOST=127.0.0.1
OPENCODE_BIN=/opt/homebrew/bin/opencode
OPENCODE_PYTHON=/opt/homebrew/bin/python3.11
OPENCODE_AGENT=general
OPENCODE_TIMEOUT=86400
OPENCODE_SERVER_USERNAME=opencode

# Safety ceiling for explicit complete/blocked agent turns. This is not a
# natural-language classifier; missing status keeps the task active.
REALM_MAX_AGENT_TURNS=56

# Keep secrets in this private env file, never in the launcher.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional but recommended for durable role/personality config.
REALM_SYSTEM_PROMPT_FILE=/Users/a.developer/.local/share/<agent-id>/system-prompt.md
